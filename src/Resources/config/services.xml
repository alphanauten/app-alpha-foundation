<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <imports>
        <import resource="./services/subscriber.xml"/>
    </imports>
    <services>
        <service id="AlphaFoundation\Core\Content\Product\ProductFeatureBuilder">
            <argument type="service" id="custom_field.repository"/>
            <argument type="service" id="Shopware\Core\System\Locale\LanguageLocaleCodeProvider"/>
            <argument type="service" id="product.repository"/>
        </service>

        <service id="AlphaFoundation\Core\Content\MarketingBanner\MarketingBannerDefinition">
            <tag name="shopware.entity.definition" entity="marketing_banner"/>
        </service>

        <service id="AlphaFoundation\Core\Content\Rule\RuleExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="AlphaFoundation\Core\Content\Product\ProductExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="AlphaFoundation\Core\Content\Category\Extension\ReviewPoolMergeExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="AlphaFoundation\Core\Content\Category\Extension\ReviewPoolMergeExtensionDefinition">
            <tag name="shopware.entity.definition" entity="alpha_review_pool_merge_extension"/>
        </service>

        <service id="AlphaFoundation\Core\Content\Property\Extension\PropertyReviewPoolMergeExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="AlphaFoundation\Core\Content\Property\Extension\PropertyReviewPoolMergeExtensionDefinition">
            <tag name="shopware.entity.definition" entity="alpha_property_review_pool_merge_extension"/>
        </service>

        <service id="AlphaFoundation\Core\Content\Product\ListingSetExtension\ListingSetExtensionDefinition">
            <tag name="shopware.entity.definition" entity="alpha_product_extension_listing_feature_set"/>
        </service>

        <service
                id="AlphaFoundation\Core\Content\MarketingBanner\Aggregate\MarketingBannerRule\MarketingBannerRuleDefinition">
            <tag name="shopware.entity.definition" entity="marketing_banner_rule"/>
        </service>

        <service
                id="AlphaFoundation\Core\Content\MarketingBanner\Aggregate\MarketingBannerTranslation\MarketingBannerTranslationDefinition">
            <tag name="shopware.entity.definition" entity="marketing_banner_translation"/>
        </service>

        <service id="AlphaFoundation\Core\Content\CmsElementConfig\CmsElementConfigDefinition">
            <tag name="shopware.entity.definition" entity="alpha_cms_element_config"/>
        </service>

        <service id="AlphaFoundation\Core\Checkout\IsBackendRule">
            <tag name="shopware.rule.definition"/>
        </service>

        <service id="AlphaFoundation\Twig\SepaQRCode" public="true">
            <tag name="twig.extension"/> <!--Required-->
        </service>

        <service id="AlphaFoundation\Service\LeafCategoriesResolver" public="false"/>

        <service id="AlphaFoundation\Core\Content\Product\SalesChannel\Review\AggregateProductReviewRoute"
                 decorates="Shopware\Core\Content\Product\SalesChannel\Review\ProductReviewRoute"
                 public="true">
            <argument type="service"
                      id="AlphaFoundation\Core\Content\Product\SalesChannel\Review\AggregateProductReviewRoute.inner"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="product_review.repository"/>
            <argument type="service" id="property_group_option.repository"/>
        </service>

        <service class="AlphaFoundation\Core\Content\Product\DataAbstractionLayer\ReviewPoolMergingRatingAverageUpdater"
                 id="Shopware\Core\Content\Product\DataAbstractionLayer\RatingAverageUpdater">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="monolog.logger"/>
        </service>

        <service class="AlphaFoundation\Resolver\CustomBuyBoxCmsElementResolver"
                 id="Shopware\Core\Content\Product\Cms\BuyBoxCmsElementResolver">
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Detail\ProductConfiguratorLoader"/>
            <argument type="service" id="product_review.repository"/>
            <argument type="service"
                      id="AlphaFoundation\Core\Content\Product\SalesChannel\Review\AggregateProductReviewRoute"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

    </services>
</container>
