
{% block sw_order_line_items_grid_grid_columns %}
    {% parent %}
    <template #column-availableStock="{ item }">
        {{ getProductAvailableStock(item) }}&nbsp;<strong>({{ getProductPhysicalStock(item) }})</strong>
    </template>

    <template #[`column-externallySent`]="{ item }">
        <template v-if="item.type === pwErpOrderLineItemTypes.PRODUCT">
            {{ getProductExternallySent(item) }}
        </template>
    </template>
{% endblock %}