
{% block sw_order_detail_base_general_info_summary %}
    {% parent %}
    <div class="sw-order-general-info__summary-invoice-address">
        <strong>{{ $tc('sw-order.createBase.detailsBody.labelBillingAddress') }}</strong>
        <address>
            <strong v-if="order.billingAddress.company">{{ order.billingAddress.company }} - </strong>
            {{ order.billingAddress.firstName }} {{ order.billingAddress.lastName }} -
            {{ order.billingAddress.street }} - {{ order.billingAddress.zipcode }} {{ order.billingAddress.city }}, {{ order.billingAddress.country.iso }}
        </address>
        <span v-if="order.billingAddress.phoneNumber">{{ $tc('sw-order.createBase.detailsBody.labelPhoneNumber') }}: {{ order.billingAddress.phoneNumber }}</span>
    </div>
{% endblock %}