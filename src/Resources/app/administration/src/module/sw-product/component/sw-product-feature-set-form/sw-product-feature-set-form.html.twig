{% block sw_product_feature_set_form_description_body %}
    <p class="sw-product-feature-set-form__description-body">
        {{ $tc('sw-product.featureSets.newDescriptionBody') }}
    </p>
{% endblock %}

{% block sw_product_feature_set_form_form %}
    <sw-container class="sw-product-feature-set-form__form">

        {% block sw_product_feature_set_form_wrapper_input %}
            <sw-inherit-wrapper
                    v-model:value="product.featureSetId"
                    :has-parent="!!parentProduct.id"
                    :inherited-value="parentProduct.featureSetId"
                    :label="$tc('sw-product.featureSets.checkoutTemplateSelectFieldLabel')"
            >
                <template #content="{ currentValue, isInherited, updateCurrentValue }">

                    {% block sw_product_feature_set_form_input %}
                        <sw-entity-single-select
                                :key="isInherited"
                                entity="product_feature_set"
                                :value="currentValue"
                                :placeholder="$tc('sw-product.featureSets.templateSelectFieldPlaceholder')"
                                :disabled="isInherited || !allowEdit"
                                show-clearable-button
                                @update:value="updateCurrentValue"
                        />
                    {% endblock %}

                </template>
            </sw-inherit-wrapper>
        {% endblock %}

        {% block sw_product_listing_feature_set_form_wrapper_input %}
            <template v-if="product.extensions.listingFeatureSet">
                <sw-inherit-wrapper
                        v-model:value="product.extensions.listingFeatureSet.featureSetId"
                        :has-parent="!!parentProduct.id"
                        :inherited-value="parentProduct.extensions?.listingFeatureSet.featureSetId"
                        :label="$tc('sw-product.featureSets.listingTemplateSelectFieldLabel')"
                >
                    <template #content="{ currentValue, isInherited, updateCurrentValue }">
                        {% block sw_product_feature_set_form_input %}
                            <sw-entity-single-select
                                    :key="isInherited"
                                    entity="product_feature_set"
                                    :value="currentValue"
                                    :placeholder="$tc('sw-product.featureSets.templateSelectFieldPlaceholder')"
                                    :disabled="isInherited || !allowEdit"
                                    show-clearable-button
                                    @update:value="updateCurrentValue"
                            />
                        {% endblock %}

                    </template>
                </sw-inherit-wrapper>
            </template>
        {% endblock %}

    </sw-container>
{% endblock %}